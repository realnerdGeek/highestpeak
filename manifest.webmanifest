{
  "name": "EarWorm",
  "short_name": "EarWorm",
  "description": "Turn videos into sounds you can loop, shuffle and trim.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#17121F",
  "theme_color": "#0A0A0D",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Shuffle everything",
      "short_name": "Shuffle",
      "url": "./?go=shuffle",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Upload",
      "url": "./?go=upload",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Library",
      "url": "./?go=library",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Search",
      "url": "./?go=search",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "video/mp4": [
          ".mp4",
          ".m4v"
        ],
        "video/quicktime": [
          ".mov"
        ],
        "video/webm": [
          ".webm"
        ],
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/mp4": [
          ".m4a"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/aac": [
          ".aac"
        ],
        "audio/flac": [
          ".flac"
        ],
        "audio/ogg": [
          ".ogg",
          ".opus"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "video/*",
            "audio/*",
            ".mp4",
            ".mov",
            ".m4a",
            ".mp3",
            ".wav"
          ]
        }
      ]
    }
  }
}